# Local Claude Code session state (not part of this project)
.remember/

# Runtime memory data (lives in $HANK_MEMORY_DIR, default ~/hank_memory)
hank_memory/

# Extension lockfiles / temp / deps
**/.lock
**/*.tmp.*
node_modules/

# Eval secrets & venv & data
.env
.venv/
locomo_eval/data/
locomo_eval/results/
locomo_eval/results_mem0/
locomo_eval/memory_runtime/
locomo_eval/*.log
__pycache__/
*.pyc

# LongMemEval raw datasets (large; download via run_phaseb.py)
eval/longmemeval/data/
eval/longmemeval/results/*.log
# never commit API keys
.minimax_key
*.key

# macOS junk
.DS_Store
